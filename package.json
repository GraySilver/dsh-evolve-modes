{
  "name": "@graysilver/dsh-task-modes",
  "version": "0.1.2",
  "description": "Task modes and read-only adversarial review for DeepSeek Harness Web",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml", "README.md", "README.zh.md", "LICENSE"],
  "scripts": {
    "build": "tsdown && node scripts/copy-types.mjs && node scripts/verify-artifacts.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "corepack pnpm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.15.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@graysilver/dsh-evolve-modes",
  "version": "0.5.0",
  "description": "Composable working, reasoning, quality, and human-reviewed self-evolution controls for DeepSeek Harness Web.",
  "license": "MIT",
  "homepage": "https://github.com/GraySilver/dsh-evolve-modes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GraySilver/dsh-evolve-modes.git"
  },
  "bugs": {
    "url": "https://github.com/GraySilver/dsh-evolve-modes/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agents",
    "prompt-engineering",
    "agent-review",
    "plan-mode",
    "acceptance-review"
  ],
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "assets", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsdown && node scripts/normalize-artifacts.mjs && node scripts/copy-types.mjs && node scripts/verify-artifacts.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run tests/*.test.ts && node --test tests/*.test.mjs",
    "pack:check": "corepack pnpm pack --pack-destination dist",
    "prepublishOnly": "corepack pnpm run typecheck && corepack pnpm run build && corepack pnpm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-persona": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-plan-mode": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <=0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.5",

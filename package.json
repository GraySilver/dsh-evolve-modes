{
  "name": "@graysilver/dsh-evolve-modes",
  "version": "0.4.1",
  "description": "Composable working, reasoning, quality, and human-reviewed self-evolution controls for DeepSeek Harness Web.",
  "license": "MIT",
  "homepage": "https://github.com/GraySilver/dsh-evolve-modes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GraySilver/dsh-evolve-modes.git"
  },
  "bugs": {
    "url": "https://github.com/GraySilver/dsh-evolve-modes/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agents",
    "prompt-engineering",
    "agent-review",
    "plan-mode",
    "acceptance-review"
  ],
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "assets", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsdown && node scripts/normalize-artifacts.mjs && node scripts/copy-types.mjs && node scripts/verify-artifacts.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run tests/*.test.ts && node --test tests/*.test.mjs",
    "pack:check": "corepack pnpm pack --pack-destination dist",
    "prepublishOnly": "corepack pnpm run typecheck && corepack pnpm run build && corepack pnpm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-plan-mode": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2 || ^0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
